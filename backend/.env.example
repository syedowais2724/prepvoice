# LiveKit Cloud Credentials (https://cloud.livekit.io - Free 5,000 minutes/month)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

# Google Gemini API Key (https://aistudio.google.com - Free tier)
GEMINI_API_KEY=your_free_google_ai_studio_key

# Optional Voice Provider Keys (for LiveKit Voice Agent)
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
